/* What's New pane (2.2.0) */
"keykey.whatsNew.summary" = "This release adds z-code punctuation in 3rd-generation Cangjie, plus a continuation-only option for associated phrases.";
"keykey.whatsNew.zcode" = "New: z-code punctuation in 三代倉頡. In the 三代倉頡（Yahoo KeyKey 相容）mode you can now type punctuation with the classic Yahoo z codes — e.g. zxcd → 「, zxce → 」, zxab → ，, zxbe → （. These were part of the original Yahoo table and are available again.";
"keykey.whatsNew.continuationOnly" = "New: 聯想只顯示接續字 option. A new checkbox in Settings ▸ General makes the associated-phrase (聯想) window show only the continuation after the character you just typed — e.g. after 關 it shows 係／心／於 instead of the full words 關係／關心／關於, like the classic Yahoo! KeyKey. Off by default; what you commit is unchanged either way.";

